# Copy to .env next to docker-compose.yml. Never commit .env.
# Every value is optional: the stack runs fully offline with these defaults.

# ---- Database / storage --------------------------------------------------
DB_PASSWORD=fixr
MINIO_ROOT_USER=fixr
MINIO_ROOT_PASSWORD=fixr-minio-secret

# ---- Auth -----------------------------------------------------------------
# HMAC key for stored OTP codes. Change it for anything beyond your laptop.
OTP_HMAC_SECRET=dev-only-otp-secret-change-me
# true = OTP is printed in the order-service log instead of sent by SMS.
FIXR_DEV_OTP=true
# The RS256 JWT key pair is generated on first run into infra/generated/ (git-ignored).

# ---- Payments (Razorpay) --------------------------------------------------
# Default: the offline stand-in `razorpay-local` (same Orders API + signed webhooks).
# For real Razorpay TEST mode: RAZORPAY_BASE=https://api.razorpay.com and your rzp_test_ keys.
RAZORPAY_BASE=http://razorpay-local:8097
RAZORPAY_KEY_ID=rzp_test_local
RAZORPAY_KEY_SECRET=local-key-secret
RAZORPAY_WEBHOOK_SECRET=local-webhook-secret
# razorpay-local sends every webhook twice to prove idempotency.
DUPLICATE_WEBHOOKS=true

# ---- Observability ----------------------------------------------------------
TRACE_SAMPLING=0.2
