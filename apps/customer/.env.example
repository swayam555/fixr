# Copy to .env in this folder. EXPO_PUBLIC_* values are baked into the app bundle: no secrets here.
# Android emulator -> host machine is 10.0.2.2; on a real phone use your laptop's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Only needed for EAS builds (written by `eas init`).
EAS_PROJECT_ID_CUSTOMER=
